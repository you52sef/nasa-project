# Optional OpenAI-compatible chat-completions API for the astronaut tutor.
# Google AI Studio offers a free Gemini API tier with usage/model limits:
# https://aistudio.google.com/apikey
# https://ai.google.dev/gemini-api/docs/openai
# The free-tier quota and model availability depend on Google's current terms.
# These server-only values are never exposed to the browser.
ASTRONAUT_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
ASTRONAUT_API_KEY=
ASTRONAUT_MODEL=gemini-3.8-flash
# ASTRONAUT_PORT=8787
